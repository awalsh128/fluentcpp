{
  "cSpell.enabled": false,
  "C_Cpp.clang_format_style": "file",
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "clang-format.executable": "/usr/bin/clang-format",
  "[c]": {
    "editor.defaultFormatter": "xaver.clang-format",
    "editor.wordBasedSuggestions": "off",
    "editor.semanticHighlighting.enabled": true
  },
  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format",
    "editor.wordBasedSuggestions": "off",
    "editor.semanticHighlighting.enabled": true
  },
  "cmake.configureSettings": {
    "CMAKE_BUILD_TYPE": "${buildType}",
    "CMAKE_C_COMPILER": "/usr/bin/clang",
    "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
    "BUILD_TESTS": true,
    "BUILD_WEBSITE": true,
    "BUILD_BENCHMARKS": true,
    "BUILD_EXAMPLES": true
  },
  "editor.rulers": [
    80
  ],
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  },
  "files.associations": {
    "type_traits": "cpp",
    "array": "cpp",
    "*.tcc": "cpp",
    "cctype": "cpp",
    "chrono": "cpp",
    "clocale": "cpp",
    "cmath": "cpp",
    "cstdint": "cpp",
    "cstdio": "cpp",
    "cstdlib": "cpp",
    "ctime": "cpp",
    "cwchar": "cpp",
    "cwctype": "cpp",
    "deque": "cpp",
    "map": "cpp",
    "set": "cpp",
    "unordered_map": "cpp",
    "vector": "cpp",
    "exception": "cpp",
    "fstream": "cpp",
    "functional": "cpp",
    "initializer_list": "cpp",
    "iosfwd": "cpp",
    "istream": "cpp",
    "limits": "cpp",
    "new": "cpp",
    "numeric": "cpp",
    "optional": "cpp",
    "ostream": "cpp",
    "ratio": "cpp",
    "sstream": "cpp",
    "stdexcept": "cpp",
    "streambuf": "cpp",
    "string": "cpp",
    "string_view": "cpp",
    "system_error": "cpp",
    "tuple": "cpp",
    "typeinfo": "cpp",
    "utility": "cpp",
    "variant": "cpp",
    "cstddef": "cpp",
    "cstring": "cpp",
    "valarray": "cpp",
    "iterator": "cpp",
    "regex": "cpp",
    "bitset": "cpp",
    "atomic": "cpp",
    "bit": "cpp",
    "condition_variable": "cpp",
    "cstdarg": "cpp",
    "algorithm": "cpp",
    "memory": "cpp",
    "memory_resource": "cpp",
    "random": "cpp",
    "future": "cpp",
    "iomanip": "cpp",
    "iostream": "cpp",
    "mutex": "cpp",
    "shared_mutex": "cpp",
    "thread": "cpp",
    "list": "cpp",
    "unordered_set": "cpp"
  }
}