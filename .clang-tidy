Checks: '-*,clang-analyzer-*,modernize-*,performance-*,bugprone-*,readability-*,portability-*,-modernize-use-trailing-return-type'
WarningsAsErrors: ''
HeaderFilterRegex: 'src/.*|include/.*'
FormatStyle: none
CheckOptions:
  - key: modernize-use-auto.MinTypeNameLength
    value: '0'
  - key: readability-identifier-naming.VariableCase
    value: camelBack
